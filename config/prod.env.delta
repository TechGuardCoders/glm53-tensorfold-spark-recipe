# Tech Guard recipe: the lines we change in glm53-tensorfold-spark's config/prod.env.example.
# Copy prod.env.example to prod.env, then apply these. Everything not listed stays at upstream's value.
# Upstream: https://github.com/jayleaton/glm53-tensorfold-spark (tested at commit b463237, image b11).

# --- the two nodes and the CX7 link ------------------------------------------------------------------------------
WORKER_SSH="<user>@<worker CX7 address>"
HEAD_IP="<head CX7 address>"
# Our QSFP cable is on CX7 port 0, so both PCIe functions of port 0 (check `ibdev2netdev`):
NCCL_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_HCA=rocep1s0f0,roceP2p1s0f0

# --- weights: our existing EXL3 checkpoint, not a fresh HF download --------------------------------------------------
# We keep the base (non-abliterated) GLM-5.3-Flash EXL3 4-bit checkpoint we already served with vLLM, in a plain folder.
# Mount its PARENT as the "HF cache" so the container sees it at /root/.cache/huggingface/<folder>.
HEAD_HF=/home/<user>/models
WORKER_HF=/home/<user>/models
MODEL_PATH=/root/.cache/huggingface/glm53-exl3
# DFlash2 drafter (incoai/GLM-5.3-Flash-DFlash2 @ 7d74cdd, CC BY-NC-ND 4.0: read its licence) downloaded into
# <models>/hub with huggingface_hub. Empty DRAFTER= falls back to the model's own MTP drafts (see results/).
DRAFTER=/root/.cache/huggingface/hub/models--incoai--GLM-5.3-Flash-DFlash2/snapshots/7d74cdd881ed7e32c31175984a67823127b66cfe

# --- API: same name and port contract as the vLLM server it replaced ------------------------------------------------
# TensorFold has no API-key check, so it listens on loopback and proxy/ (Caddy) owns :8000 with the Bearer key.
SERVED_NAME=glm-5.3-flash
HOST=127.0.0.1
PORT=8001
# Clients written against vLLM read `reasoning_content`; newer ones read `reasoning`. Send both.
GLM53_TF_REASONING_FIELDS=both

# --- memory gate without passwordless sudo ---------------------------------------------------------------------------
# serve.sh drops page caches with `sudo -n`; our service account has no passwordless sudo. ops/glm-tf-start.sh drops
# them with a privileged one-shot container instead (docker group), so serve.sh's own drop is turned off.
MEM_GATE_DROP_CACHES=0

# --- default sampling: greedy unless the client asks otherwise -------------------------------------------------------
# A request without `temperature` gets the model's generation_config default, 1.0. TensorFold drafts DFlash2 only on
# greedy rounds, so agent frameworks that never send a temperature lose DFlash2 entirely: measured 4.36 -> 5.73 tokens
# a round and ~68 -> ~83 tok/s with this set. Clients that send a temperature keep theirs.
# No spaces in EXTRA_ARGS: serve.sh word-splits it into the docker run line ("--temperature 0" makes "0" the image).
EXTRA_ARGS=--temperature=0

# --- watchdog signal -------------------------------------------------------------------------------------------------
# Mark a request stalled after 300 s without a token (prefill time is allowed for by GLM53_TF_STALL_PREFILL_TPS).
# Our watchdog restarts on tensorfold_requests_stalled > 0 or tensorfold_engine_fatal > 0 for 3 checks.
GLM53_TF_STALL_S=300
